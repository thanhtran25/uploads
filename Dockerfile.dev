FROM node:20-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

RUN mkdir -p /app/downloads

ENV CHROMIUM_PATH=/usr/bin/chromium
EXPOSE 3000
CMD ["npm", "run", "start:dev"]
